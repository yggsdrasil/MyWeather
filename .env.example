# ---------------------------------------------------------------------------
# Adobe Target MCP client configuration
# Copy this file to ".env" and adjust values as needed.
# ---------------------------------------------------------------------------

# Port the local web app / API server listens on.
PORT=4321

# Public base URL the browser uses to reach this app. Each server's OAuth
# redirect URL is derived from this as `${PUBLIC_BASE_URL}/oauth/callback/<id>`
# (e.g. /oauth/callback/target, /oauth/callback/analytics). When running
# locally this should match the host/port above.
PUBLIC_BASE_URL=http://localhost:4321

# Adobe MCP server endpoints. The Target and Analytics defaults are Adobe's
# public-beta servers and normally do not need to change. Set any value to "off"
# to hide that server from the app.
TARGET_MCP_URL=https://targetmcp.adobe.io/mcp
ANALYTICS_MCP_URL=https://aa-mcp.adobe.io/mcp

# --- Adobe Launch (Experience Platform Data Collection / Tags) ---------------
# The Launch server can connect in two ways:
#
# 1) Reactor REST API (recommended) — Adobe Launch has no public MCP server, so
#    the app talks to the Reactor API (https://reactor.adobe.io) directly using
#    Adobe IMS server-to-server credentials. Provide EITHER a static access
#    token, OR a client id + secret (the app mints/refreshes tokens itself).
#    When any of these is set, Launch uses the Reactor API automatically.
# LAUNCH_TENANT=your-tenant
# LAUNCH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LAUNCH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LAUNCH_ACCESS_TOKEN=eyJ...                # optional static token
# LAUNCH_ORG_ID=XXXXXXXXXXXXXXXXXXXXXXXX@AdobeOrg   # optional; derived from token
# LAUNCH_COMPANY_ID=COxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # optional; first company used otherwise
# LAUNCH_REACTOR_URL=https://reactor.adobe.io           # optional override
# LAUNCH_SCOPES=openid, AdobeID, read_organizations, additional_info.projectedProductContext, additional_info.roles
#
# 2) MCP server — if/when Adobe publishes a hosted Launch MCP server (or you run
#    your own), set its URL here. Used only when no Reactor credentials are set.
#    Set to "off" to hide the Launch server entirely.
LAUNCH_MCP_URL=https://launch-mcp.adobe.io/mcp

# Where to persist OAuth tokens + dynamically-registered client info between
# restarts. Relative paths are resolved from the project root. Keep this file
# private; it contains access/refresh tokens.
DATA_DIR=.data

# ---------------------------------------------------------------------------
# AI assistant (optional)
#
# The "Assistant" tab turns plain-language prompts ("which homepage A/B tests
# are winning?") into Adobe Target MCP tool calls and summarizes the results.
# It needs an LLM API key. Without one, the app still works as a manual tool
# browser via the "Tools" tab.
#
# Set ONE provider's API key. The provider is auto-detected from whichever key
# is present (override with LLM_PROVIDER).
# ---------------------------------------------------------------------------

# Anthropic (Claude):
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (or any OpenAI-compatible API):
# OPENAI_API_KEY=sk-...

# Optional overrides:
# LLM_PROVIDER=anthropic        # "anthropic" | "openai"
# LLM_MODEL=claude-sonnet-4-6   # default depends on provider
#   Anthropic options: claude-sonnet-4-6 (recommended), claude-opus-4-8, claude-haiku-4-5
#   OpenAI default: gpt-4o
# LLM_BASE_URL=                 # for OpenAI-compatible / proxy endpoints
# LLM_MAX_STEPS=10              # max tool-call iterations per message
# LLM_MAX_TOKENS=2048

# Cost estimates: the app shows per-query token usage and an estimated USD cost
# (plus a running session total) based on a built-in price table for known
# models. Override the price (USD per 1,000,000 tokens) if your rates differ or
# your model isn't recognized:
# LLM_PRICE_INPUT=3
# LLM_PRICE_OUTPUT=15
