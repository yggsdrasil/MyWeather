{
  "name": "adobe-target-mcp-client",
  "version": "1.0.0",
  "description": "A web application that connects to Adobe Target through Adobe's Model Context Protocol (MCP) server.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/agent-itest.mjs anthropic && node scripts/agent-itest.mjs openai"
  },
  "keywords": [
    "adobe-target",
    "mcp",
    "model-context-protocol",
    "experimentation",
    "personalization"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
